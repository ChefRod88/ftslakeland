# Copy to `.dev.vars` for local development (git-ignored).
# In production set these with: wrangler secret put NAME

# Resend transactional email (https://resend.com) — API key.
# If unset, emails are logged to the console instead of sent (dev still works).
RESEND_API_KEY=

# Cloudflare Turnstile secret (https://dash.cloudflare.com -> Turnstile).
# The always-passing test secret below is fine for local dev.
# The matching PUBLIC site key lives in wrangler.toml [vars] TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
